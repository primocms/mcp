{
	"name": "primo-mcp",
	"version": "0.1.11-rc.3",
	"description": "Official Primo MCP server for live, versioned docs and validation in exported Primo sites.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./compiler": "./dist/tools/publish_compiler.js"
	},
	"bin": {
		"primo-mcp": "./dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/primocms/mcp.git"
	},
	"homepage": "https://primo.build",
	"bugs": {
		"url": "https://github.com/primocms/mcp/issues"
	},
	"author": "Primo",
	"license": "MIT",
	"files": [
		"dist",
		"src/reference/**/*.md",
		"src/schemas/**/*.json"
	],
	"scripts": {
		"build": "node scripts/sync-field-types.mjs && tsc && node scripts/copy-reference.mjs",
		"smoke": "node scripts/smoke-tests.mjs",
		"test:dev-runtime": "node --test scripts/test-dev-runtime.mjs",
		"test:resolution": "node scripts/test-svelte-resolution.mjs",
		"test:null-image": "node scripts/test-null-image-value.mjs",
		"test:image-focal-point": "node --test scripts/test-image-focal-point.mjs",
		"test:link-active": "node --test scripts/test-link-active.mjs",
		"test:publish-cache": "node --test scripts/test-publish-cache-version.mjs scripts/test-publish-cache-browser.mjs scripts/test-incremental-publish.mjs scripts/test-incremental-publish-cms.mjs",
		"prepack": "npm run build",
		"benchmark:publish": "npm run build && node scripts/benchmark-publish.mjs",
		"test:publish-hydration": "node --test scripts/test-publish-hydration.mjs"
	},
	"engines": {
		"node": ">=18.18"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.31.0",
		"ajv": "^8.20.0",
		"esbuild": "^0.28.2",
		"js-yaml": "^4.3.2",
		"markdown-it": "^14.3.3",
		"postcss": "^8.5.23",
		"postcss-nested": "^7.0.2",
		"svelte": "^5.55.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.3"
	}
}
